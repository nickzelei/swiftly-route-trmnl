# Copy to .env (gitignored). mise loads this file into the environment for
# every repo command (see mise.toml [env]). All values are optional — without
# them, trmnl previews fall back to static data and the worker smoketest needs
# the var passed inline instead.

# --- TRMNL live preview (trmnl/) ---
# trmnlp resolves {{ env.BACKEND_URL }} / {{ env.BACKEND_SECRET }} in
# trmnl/.trmnlp.yml when previewing against live data.

# Base URL of your deployed Swiftly backend Worker (no query string), or
# http://localhost:8787 when running the Worker locally (cd worker && npm run dev).
BACKEND_URL=https://your-worker.example.workers.dev

# Only needed if the Worker has the BACKEND_SECRET gate set. Must match the
# Worker's BACKEND_SECRET (see worker/.dev.vars.example).
BACKEND_SECRET=

# --- Worker smoketest (worker/) ---
# Read by worker/_smoketest.ts via process.env, so `mise exec -- node
# _smoketest.ts` works with no inline var. This does NOT configure a deployed
# Worker — production secrets go via `wrangler secret put`, and `wrangler dev`
# reads worker/.dev.vars (see worker/.dev.vars.example).
SWIFTLY_API_KEY=
