# Copy to .env (gitignored). mise loads this file into the environment for
# every repo command — including every `mise run <task>` (see mise.toml
# [env] and [tasks]). Optional — without it, trmnl previews fall back to
# static data, the explore scripts refuse to run, and `mise run deploy`
# falls back to `trmnlp login`'s stored credentials.

# --- TRMNL live preview ---
# Used two ways when previewing against live data (comment out the
# `variables:` block in .trmnlp.yml first):
#   1. trmnlp resolves {{ env.SWIFTLY_API_KEY }} in .trmnlp.yml to build the
#      Authorization header for the direct Swiftly poll.
#   2. src/transform.ts reads it directly via process.env as a fallback,
#      since trmnlp's local custom_fields_values (unlike
#      polling_url/headers) don't get {{ env.X }} resolved before reaching
#      the transform — see README.md's Preview data section.
#
# Also used by scripts/{explore-routes,trip-updates,vehicle-positions}.mjs
# (see scripts/swiftly.mjs) and by nothing else — production installs never
# read this; TRMNL installers enter their own key as a plugin form field.
SWIFTLY_API_KEY=

# --- explore scripts (scripts/explore-routes.mjs etc.) ---
# Your Swiftly agency key (Swiftly includes it alongside your API key).
AGENCY_KEY=

# --- Deploying (mise run deploy / trmnlp push) ---
# Your TRMNL account's API key (Account > API Keys in the TRMNL dashboard).
# Lets `mise run deploy` push straight from your machine with no `trmnlp
# login` step — trmnlp itself reads this exact env var name.
TRMNL_API_KEY=
