{% comment %}
  TRMNL "Full" layout (800x480). Renders the JSON the serverless transform
  returns; see README.md for the shape. Each route direction is a column;
  each trip is one row — its stop chain over the matching time chain.
{% endcomment %}

<div class="layout">
  {% if sections.size > 0 %}
  <div class="columns portrait:flex--col portrait:gap--large">
    {% for sec in sections limit: 2 %}
      <div class="column gap--xlarge portrait:w--full">
        <span class="title">{{ sec.title }}</span>

        {% if sec.trips.size > 0 %}
          {% for trip in sec.trips limit: 4 %}
            <div class="item">
              <div class="content gap--small">
                <span class="label label--large">{% for stop in trip.stops %}{% unless forloop.first %} &rarr; {% endunless %}{{ stop.name }}{% endfor %}</span>
                <span class="value value--mega value--tnums" data-value-fit="true">{% for stop in trip.stops %}{% unless forloop.first %} &rarr; {% endunless %}{{ stop.time }}{% endfor %}</span>
                <span class="label label--large">{{ trip.vehicle }}</span>
              </div>
            </div>
          {% endfor %}
        {% else %}
          <span class="label">No upcoming sailings</span>
        {% endif %}
      </div>
    {% endfor %}
  </div>
  {% else %}
    <span class="label">{{ error | default: "Set the plugin's agency and route." }}</span>
  {% endif %}
</div>

<div class="title_bar">
  <img class="image image-dither" src="https://usetrmnl.com/images/plugins/private_plugin.svg" />
  <span class="title">{{ route_name | default: "Ferry" }}</span>
  <span class="instance">Updated {{ updated_at }}</span>
</div>
