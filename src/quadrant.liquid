{% comment %}
  TRMNL "Quadrant" layout (400x240). A mobile-style column stack: the route's
  two directions stacked top/bottom, each shows only the next trip — a stop
  chain over the matching time chain, kept compact for the tight space.
  See trmnl/README.md.
{% endcomment %}

<div class="layout">
  {% if sections.size > 0 %}
  <div class="flex flex--col gap--small w--full">
    {% for sec in sections limit: 2 %}
      <div class="flex flex--col w--full">
        <span class="title title--small">{{ sec.title }}</span>

        {% if sec.trips.size > 0 %}
          {% assign trip = sec.trips.first %}
          <div class="item">
            <div class="content">
              <span class="label label--small" data-clamp="1">{% for stop in trip.stops %}{% unless forloop.first %} &rarr; {% endunless %}{{ stop.name }}{% endfor %}</span>
              <span class="value value--small value--tnums" data-value-fit="true">{% for stop in trip.stops %}{% unless forloop.first %} &rarr; {% endunless %}{{ stop.time }}{% endfor %}</span>
              <span class="label label--small">{{ trip.vehicle }}</span>
            </div>
          </div>
        {% else %}
          <span class="label">No upcoming sailings</span>
        {% endif %}
      </div>
    {% endfor %}
  </div>
  {% else %}
    <span class="label">{{ error | default: "Set the plugin's agency and route." }}</span>
  {% endif %}
</div>

<div class="title_bar">
  <img class="image image-dither" src="https://usetrmnl.com/images/plugins/private_plugin.svg" />
  <span class="title">{{ route_name | default: "Ferry" }}</span>
  <span class="instance">Updated {{ updated_at }}</span>
</div>
