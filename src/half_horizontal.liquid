{% comment %}
  TRMNL "Half Horizontal" layout (800x240). Each route direction is a column
  showing its next trip — the stop chain over the matching time chain.
  See README.md for the data shape.
{% endcomment %}

<div class="layout">
  {% if sections.size > 0 %}
  <div class="columns portrait:flex--col portrait:gap--large">
    {% for sec in sections limit: 2 %}
      <div class="column portrait:w--full">
        <span class="title">{{ sec.title }}</span>

        {% if sec.trips.size > 0 %}
          {% assign trip = sec.trips.first %}
          <div class="item">
            <div class="content">
              <span class="label label--small">{% for stop in trip.stops %}{% unless forloop.first %} &rarr; {% endunless %}{{ stop.name }}{% endfor %}</span>
              <span class="value value--xlarge value--tnums" data-value-fit="true">{% for stop in trip.stops %}{% unless forloop.first %} &rarr; {% endunless %}{{ stop.time }}{% endfor %}</span>
              <span class="label label--small">{{ trip.vehicle }}</span>
            </div>
          </div>
        {% else %}
          <span class="label">No upcoming sailings</span>
        {% endif %}
      </div>
    {% endfor %}
  </div>
  {% else %}
    <span class="label">{{ error | default: "Set the plugin's agency and route." }}</span>
    {% if detail %}<span class="label label--small">{{ detail }}</span>{% endif %}
  {% endif %}
</div>

<div class="title_bar">
  <img class="image image-dither" src="https://usetrmnl.com/images/plugins/private_plugin.svg" />
  <span class="title">{{ route_name | default: "Ferry" }}</span>
  <span class="instance">Updated {{ updated_at }}</span>
</div>
