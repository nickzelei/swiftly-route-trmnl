{% comment %}
  TRMNL "Half Vertical" layout (400x480). A mobile-style column stack: the
  route's two directions stacked top/bottom, each shows up to 3 sailing time
  groups. See trmnl/README.md.
{% endcomment %}

<div class="layout">
  {% if sections.size > 0 %}
  <div class="flex flex--col gap--large w--full">
    {% for sec in sections limit: 2 %}
      <div class="flex flex--col gap--small w--full">
        <span class="title">{{ sec.title }}</span>

        {% if sec.groups.size > 0 %}
          {% for g in sec.groups limit: 3 %}
            <div class="item">
              <div class="content">
                <span class="value value--large value--tnums">{{ g.time }}</span>
                {% for s in g.sailings %}
                  <span class="label label--small">{% if s.kind == "departure" %}DEPARTS{% else %}ARRIVES{% endif %} &middot; {{ s.vehicle }}{% if s.stop != blank %} &middot; {{ s.stop }}{% endif %}</span>
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        {% else %}
          <span class="label">No upcoming sailings</span>
        {% endif %}
      </div>
    {% endfor %}
  </div>
  {% else %}
    <span class="label">{{ error | default: "Set the plugin's agency and route." }}</span>
  {% endif %}
</div>

<div class="title_bar">
  <img class="image" src="https://usetrmnl.com/images/plugins/private_plugin.svg" />
  <span class="title">{{ route_name | default: "Ferry" }}</span>
  <span class="instance">Updated {{ updated_at }}</span>
</div>
